# Copy to .env.local and fill in. Never commit real values.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Demo key only (public by design, fenced in by the ingest function). The device key never goes here.
VITE_DEMO_INGEST_KEY=<value of app_config.demo_ingest_key in Supabase>
